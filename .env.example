# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION MANATY (AutoClipper)
# ═══════════════════════════════════════════════════════════════════════════════
# Copie ce fichier en .env et remplis les valeurs

# --- DISCORD ---
DISCORD_TOKEN=ton_token_discord_ici
CHANNEL_INPUT_ID=123456789012345678
CHANNEL_OUTPUT_ID=123456789012345678

# --- STREAMABLE (pour les vidéos > 25 Mo) ---
# Compte gratuit : https://streamable.com
STREAMABLE_USER=ton_email_streamable
STREAMABLE_PASS=ton_mot_de_passe_streamable

# --- ASSEMBLYAI (optionnel, meilleure transcription) ---
# Clé API : https://www.assemblyai.com
ASSEMBLYAI_API_KEY=ta_cle_assemblyai
